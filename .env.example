# ============================================================================
# forex-bot — exemplo de configuração. Copie para .env e preencha.
# NUNCA commite o .env. Nenhum valor real deste arquivo vai para o git.
# ============================================================================

# --- Modo de operação -------------------------------------------------------
# demo | real. Default e fail-closed: qualquer valor inválido resolve para demo.
# Para operar real, além de TRADING_MODE=real é preciso REAL_TRADING_UNLOCKED=true,
# que só deve ser setado manualmente após os gates de promoção passarem.
TRADING_MODE=demo
REAL_TRADING_UNLOCKED=false

# --- Banco ------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://forex:forex@127.0.0.1:5432/forex_bot

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- MetaTrader 5 (terminal local) -----------------------------------------
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
MT5_TIMEOUT_MS=10000

# --- Regras de risco (§4 do PRD) -------------------------------------------
MAX_RISK_PER_TRADE_PCT=1.0
MAX_TOTAL_EXPOSURE_PCT=3.0
MAX_DAILY_LOSS_PCT=5.0
MAX_TRADES_PER_DAY=10
ATR_SL_MULTIPLIER=2.0
MACRO_BLACKOUT_MINUTES=15

# --- Regras FTMO ------------------------------------------------------------
FTMO_MAX_DAILY_LOSS_PCT=5.0
FTMO_MAX_DRAWDOWN_PCT=10.0

# --- Gates de promoção demo -> real (§5 do PRD) ----------------------------
PROMOTION_MIN_TRADES=200
PROMOTION_MIN_WIN_RATE=0.55
PROMOTION_MIN_SHARPE=1.0
PROMOTION_MAX_DRAWDOWN_PCT=10.0
PROMOTION_MIN_PROFIT_FACTOR=1.3
PROMOTION_MAX_BACKTEST_DEVIATION_PCT=15.0

# --- Coletores --------------------------------------------------------------
NEWS_RSS_FEEDS=https://www.forexlive.com/feed/news
TWITTER_BEARER_TOKEN=
TWITTER_CASHTAGS=$EURUSD,$GBPUSD,$USDJPY

# --- NLP --------------------------------------------------------------------
SENTIMENT_MODEL=ProsusAI/finbert
SENTIMENT_CACHE_TTL_SECONDS=86400

# --- Observabilidade --------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO
